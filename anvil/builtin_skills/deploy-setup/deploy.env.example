# Copy to deploy.env on the server (next to deploy.sh) and adjust. Keep secrets out of this file.

# Branch to deploy.
BRANCH=main

# How to build: auto (detects docker compose, npm/pnpm/yarn, Python, Go), none, or your own command.
BUILD_CMD=auto
# BUILD_CMD="npm ci && npm run build"

# How to restart: auto (docker compose if present), none, systemd:<unit>, pm2:<name>, docker, or a command.
RESTART=auto
# RESTART=systemd:myapp
# RESTART=pm2:myapp

# Optional health check. If it fails, deploy.sh rolls back to the previous commit.
# HEALTHCHECK_URL=http://127.0.0.1:3000/health
# HEALTHCHECK_CMD="systemctl is-active --quiet myapp"
HEALTHCHECK_TIMEOUT=60
